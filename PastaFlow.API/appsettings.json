{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Formatting.Compact"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  },
  "AllowedHosts": "*",
  "UseHttpsRedirection": false,
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Jwt": {
    "_comment": "En producción definir Jwt__SecretKey como variable de entorno (mín. 32 caracteres).",
    "SecretKey": "",
    "Issuer": "PastaFlow.API",
    "Audience": "PastaFlow.Client",
    "ExpirationHours": 8
  },
  "Seeding": {
    "RegenerarVentasHistoricas": false,
    "BootstrapUsers": false
  },
  "ComprasInsight": {
    "HoraInicioDia": "07:00:00",
    "ZonaHoraria": "America/Argentina/Buenos_Aires",
    "DiasHistorial": 30,
    "FinesDeSemanaHistorial": 4,
    "MinutosAntesDelInicioOperativo": 2,
    "JobNocturnoHabilitado": false,
    "EnviarEmailEnGeneracionAutomatica": false
  },
  "Email": {
    "_comment": "Configurar vía variables de entorno Email__Password, Email__Usuario, etc.",
    "Habilitado": false,
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "UseStartTls": true,
    "Usuario": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "PastaFlow",
    "DestinatariosInsight": []
  },
  "Llm": {
    "Provider": "Gemini"
  },
  "Groq": {
    "_comment": "Variable de entorno: Groq__ApiKey",
    "ApiKey": "",
    "Model": "llama-3.3-70b-versatile"
  },
  "Gemini": {
    "_comment": "Variable de entorno: Gemini__ApiKey",
    "ApiKey": "",
    "Model": "gemini-2.5-flash"
  },
  "Clima": {
    "Latitude": -34.6037,
    "Longitude": -58.3816,
    "Timezone": "America/Argentina/Buenos_Aires",
    "TempMaxFrioC": 14,
    "PrecipLluviaMm": 2
  }
}
