{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Formatting.Compact"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "_comment": "ADVERTENCIA: SecretKey solo para desarrollo local. En producción usar variable de entorno Jwt__SecretKey o User Secrets.",
    "SecretKey": "PastaFlow-SuperSecretKey-2026-MustBe32CharsMin!",
    "Issuer": "PastaFlow.API",
    "Audience": "PastaFlow.Client",
    "ExpirationHours": 8
  },
  "ComprasInsight": {
    "HoraInicioDia": "07:00:00",
    "ZonaHoraria": "America/Argentina/Buenos_Aires",
    "DiasHistorial": 30,
    "FinesDeSemanaHistorial": 4,
    "MinutosAntesDelInicioOperativo": 2,
    "JobNocturnoHabilitado": true,
    "EnviarEmailEnGeneracionAutomatica": true
  },
  "Email": {
    "_comment": "",
    "Habilitado": true,
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "UseStartTls": true,
    "Usuario": "francorodriguez429@gmail.com",
    "Password": "",
    "FromAddress": "francorodriguez429@gmail.com",
    "FromName": "DonFranco Insight",
    "DestinatariosInsight": ["cristian45906@gmail.com"]
  },
  "Llm": {
    "Provider": "Gemini"
  },
  "Groq": {
    "_comment": "En producción usar variable de entorno Groq__ApiKey. Clave gratis en https://console.groq.com",
    "ApiKey": "",
    "Model": "llama-3.3-70b-versatile"
  },
  "Gemini": {
    "_comment": "En producción usar variable de entorno Gemini__ApiKey. Requiere créditos en https://aistudio.google.com",
    "ApiKey": "",
    "Model": "gemini-2.5-flash"
  }
}
