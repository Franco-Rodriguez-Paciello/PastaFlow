# ============================================================
# .gitignore para proyectos .NET 10 / C#
# ============================================================

# ------ Carpetas de compilación ------
[Bb]in/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/
.build-check/

# ------ Archivos de usuario y configuración local de IDEs ------
*.user
*.userosscache
*.suo
*.userprefs
.vs/
*.vscode/
.idea/
*.sln.iml
*.resharper
_ReSharper*/
*.dotCover
*.ncrunch*

# ------ Archivos de publicación y despliegue ------
[Pp]ublish/
PublishProfiles/
*.pubxml
*.pubxml.user
*.azurePubxml
ServiceFabricBackup/
*.pfx
*.snk

# ------ Paquetes NuGet ------
*.nupkg
*.snupkg
packages/
!**/packages/build/
nuget.exe
project.lock.json
project.fragment.lock.json
artifacts/

# ------ Archivos de Entity Framework ------
*.mdf
*.ldf
*.ndf

# ------ Secretos locales y configuración sensible ------
appsettings.Development.json
appsettings.Local.json
appsettings.*.Local.json
secrets.json
*.pfx
*.p12
*.key
*.pem

# ------ Variables de entorno ------
.env
.env.*
!.env.example

# ------ Archivos temporales y de caché ------
*.tmp
*.temp
*.bak
*.cache
*.orig
~$*
*.swp
Thumbs.db
Desktop.ini
.DS_Store

# ------ Cobertura de código y reportes de pruebas ------
TestResults/
coverage/
coverage.xml
*.coveragexml
*.coverage
*.trx

# ------ Benchmark ------
BenchmarkDotNet.Artifacts/

# ------ Herramientas de análisis estático ------
.sonarqube/
StyleCop.Cache

# ------ Docker ------
docker-compose.override.yml

# ------ Azure ------
.azure/
ServiceFabricBackup/
*.azurePubxml

# ------ Node / frontend (si aplica) ------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp/
.pnp.js
dist/

# ------ Archivos generados automáticamente ------
*.g.cs
*.g.i.cs
*.AssemblyAttributes.cs
*.AssemblyInfo.cs
