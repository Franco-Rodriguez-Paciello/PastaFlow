# Copiá este archivo a .env y completá los valores antes de docker compose up

# PostgreSQL (servicio db)
POSTGRES_USER=pastaflow
POSTGRES_PASSWORD=cambiar_por_una_clave_segura
POSTGRES_DB=pastaflow

# API — obligatorio en producción (mínimo 32 caracteres)
JWT_SECRET_KEY=cambiar_por_una_clave_jwt_de_al_menos_32_caracteres

# IA — opcional (sin clave, las funciones de IA no estarán disponibles)
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_PROVIDER=Gemini

# Primer despliegue: crea usuarios admin/operario si la tabla Usuarios está vacía
# Credenciales: ver UsuarioDataSeeder en Infrastructure (solo si BootstrapUsers=true)
SEEDING_BOOTSTRAP_USERS=true
